<hstack class="doc-callout doc-callout-{{ dsx.attribute.kind }}" role="note">
  <head>
    <!--
      The admonition: a hairline box whose hue lives only in the kind icon and
      the border, an optional neutral title, and the body slot (nested markdown
      chunks from the compiler). Authored in markdown as <Callout kind="...">,
      or through the sugar tags Note / Info / Tip / Warning / Danger
      (scripts/compile.mjs rewrites those to kinds). Looks live in DocShell.css
      (the sheet that reaches every page), tokens only.
    -->
    <attribute as="kind" default="'note'"/>
    <attribute as="title" default="''"/>
    <formula as="icon" kind="dsx.attribute.kind">
      if (kind === 'info') { return 'info.circle.fill' }
      if (kind === 'tip') { return 'sparkles' }
      if (kind === 'warning') { return 'exclamationmark.triangle.fill' }
      if (kind === 'danger') { return 'xmark' }
      return 'note.text'
    </formula>
  </head>
  <image icon="{{ dsx.formula.icon }}" iconSize="16" class="doc-callout-icon"/>
  <stack class="doc-callout-content">
    <text value="{{ dsx.attribute.title }}" class="doc-callout-title" visible-if="dsx.attribute.title !== ''"/>
    <stack class="doc-callout-body">
      <slot/>
    </stack>
  </stack>
</hstack>
