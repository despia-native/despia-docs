<stack style="gap: 0; min-height: 100vh; background: background">
  <head>
    <!--
      The one layout every documentation page mounts (the generated page components wrap
      their <markdown> body in this shell). Head = the site chrome's state and logic:
      the nav model and the search index are build artifacts fetched as data, the search
      itself is a formula over that index - client-side, no server dependency, exactly
      the W7.3 claim. The raw-markdown control is a link to the page's /md sibling, the
      copy-as-markdown contract in its simplest honest form.
    -->
    <attribute as="title" default="'Despia docs'"/>
    <attribute as="route" default="'/'"/>
    <!-- md = the raw-markdown sibling. Compiled pages always pass it; a hand-authored
         page (no markdown source) omits it and the control stays hidden. -->
    <attribute as="md" default="''"/>
    <variable as="query">return ''</variable>
    <api as="nav" url="/nav.json"/>
    <api as="searchIndex" url="/search-index.json"/>
    <formula as="sidebarRows" inputs="model">
      const rows = []
      if (!model || !model.sections) { return rows }
      for (const section of model.sections) {
        rows.push({ id: 'section:' + section.name, kind: 'section', label: section.name, route: '' })
        for (const page of section.pages) {
          rows.push({ id: 'page:' + page.route, kind: 'page', label: page.title, route: page.route })
        }
      }
      return rows
    </formula>
    <formula as="hits" inputs="q">
      const out = []
      if (!q || q.length < 2) { return out }
      const needle = q.toLowerCase()
      const index = searchIndex.data
      if (!index || !index.pages) { return out }
      for (const page of index.pages) {
        if (out.length >= 8) { break }
        if (page.title.toLowerCase().includes(needle)) {
          out.push({ id: page.route, title: page.title, route: page.route, where: page.section })
        }
      }
      for (const page of index.pages) {
        if (out.length >= 8) { break }
        if (!page.title.toLowerCase().includes(needle) && page.text.toLowerCase().includes(needle)) {
          out.push({ id: page.route, title: page.title, route: page.route, where: page.section })
        }
      }
      return out
    </formula>
  </head>

  <hstack style="gap: 1rem; padding: 0.75rem 1.5rem; border-bottom: 1px solid var(--dsx-separator); align-items: center; position: sticky; top: 0; background: background">
    <text value="Despia" style="font-weight: 700; font-size: 1.1rem" href="/"/>
    <text value="docs" style="color: secondary"/>
    <spacer/>
    <textfield bind="dsx.variable.query" placeholder="Search the docs" style="min-width: 16rem"/>
    <text value="GitHub" href="https://github.com/despia-native/despia" style="color: secondary"/>
  </hstack>

  <list bind="dsx.formula.hits(dsx.variable.query)" key="id" scroll="false">
    <row href="{{ item.route }}">
      <hstack style="gap: 0.75rem; padding: 0.25rem 1.5rem">
        <text bind="item.title" style="font-weight: 600"/>
        <text bind="item.where" style="color: secondary"/>
      </hstack>
    </row>
  </list>

  <hstack style="gap: 0; align-items: flex-start">
    <stack style="width: 16rem; padding: 1rem 0.75rem; gap: 0; border-right: 1px solid var(--dsx-separator); position: sticky; top: 3.25rem">
      <list bind="dsx.formula.sidebarRows(dsx.api.nav.data)" key="id" scroll="false">
        <row href="{{ item.route }}">
          <text bind="item.label" style="padding: 0.3rem 0.75rem"/>
        </row>
      </list>
    </stack>

    <stack style="gap: 1rem; padding: 2rem 2.5rem; max-width: 46rem; flex: 1">
      <hstack visible-if="dsx.attribute.md !== ''" style="gap: 1rem; align-items: center">
        <spacer/>
        <text value="View as Markdown" href="{{ dsx.attribute.md }}" style="color: secondary; font-size: 0.85rem"/>
      </hstack>
      <slot/>
      <divider/>
      <text value="Apache-2.0. The raw markdown of every page lives under /md; the whole site is one llms.txt away." style="color: secondary; font-size: 0.85rem"/>
    </stack>
  </hstack>
</stack>
